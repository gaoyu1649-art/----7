/**
  ******************************************************************************
  * @file    motion_monitor.c
  * @brief   运动监测库实现
  *
  * 判定思路（不涉及姿态解算，保持简单可解释）：
  *   1) 合加速度模长偏离 1 g 超过阈值  -> 视为有线性加速度
  *   2) 合角速度模长超过阈值           -> 视为在转动
  *   两者任一成立即判为"运动"，并用计数器做去抖，避免抖动导致 LED 闪烁。
  *
  * 同时用互补滤波给出 pitch / roll 两个姿态角，仅供 CubeMonitor 观察与导出。
  * 注意：角度符号与安装方向有关，若发现方向相反，把对应轴的符号取反即可。
  ******************************************************************************
  */
#include "main.h"
#include "bsp_bmi088.h"
#include "motion_monitor.h"
#include "tim.h"
#include <math.h>

/* main.c 中已有的呼吸灯使能标志，这里借用来停掉 TIM5 的呼吸效果 */
extern volatile uint32_t pwm_on;

/* ---------------- 判定阈值（可调） ---------------- */
#define MOTION_ACC_THRESH_G     0.10f   /* 偏离 1 g 超过 0.10 g 判为运动 */
#define MOTION_GYRO_THRESH_DPS  8.0f    /* 角速度超过 8 deg/s 判为运动 */
#define MOTION_DEBOUNCE_N       20U     /* 去抖计数上限，200Hz 下约 100 ms */

#define RAD_TO_DEG              57.29578f
#define COMP_FILTER_ALPHA       0.98f   /* 陀螺积分权重，越大越平滑但越依赖陀螺零漂 */


volatile int16_t imu_acc_x = 0, imu_acc_y = 0, imu_acc_z = 0;
volatile int16_t imu_gyro_x = 0, imu_gyro_y = 0, imu_gyro_z = 0;
volatile float   imu_acc_norm = 0.0f;
volatile float   imu_gyro_norm = 0.0f;
volatile float   imu_pitch = 0.0f;
volatile float   imu_roll = 0.0f;
volatile uint8_t imu_moving = 0;
volatile uint8_t imu_chip_id_acc = 0;
volatile uint8_t imu_chip_id_gyro = 0;
volatile int8_t  imu_init_status = -1;
/* 调试用：加速度计关键寄存器的回读值 */
volatile uint8_t imu_dbg_chip_id = 0;
volatile uint8_t imu_dbg_pwr_ctrl = 0;
volatile uint8_t imu_dbg_pwr_conf = 0;
volatile uint8_t imu_dbg_conf = 0;
volatile uint8_t imu_dbg_range = 0;

/* ---------------- 内部状态 ---------------- */
static uint32_t s_last_tick = 0;
static uint8_t  s_debounce = 0;
static uint16_t s_green_full = 1000;    /* TIM5 满占空对应的 CCR 值 */
static uint8_t  s_led_state = 0xFF;     /* 0xFF 表示"还没设置过"，保证上电刷新一次 */


static void led_green(uint8_t on)
{

    pwm_on = 0;
    HAL_GPIO_WritePin(LED_G_GPIO_Port, LED_G_Pin, on ? GPIO_PIN_SET : GPIO_PIN_RESET);
}


static void led_red(uint8_t on)
{
    HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin,
                      on ? GPIO_PIN_SET : GPIO_PIN_RESET);
}

int motion_monitor_init(void)
{
    int r;
    uint8_t acc_id = 0, gyro_id = 0;

    /* 记录满占空值，避免写死 ARR */
    s_green_full = (uint16_t)__HAL_TIM_GET_AUTORELOAD(&htim5);

    /* 先把两个灯都灭掉 */
    led_red(0);
    led_green(0);

    r = bmi088_init(BMI088_ACC_6G, BMI088_GYRO_1000DPS);
    imu_init_status = (int8_t)r;

    if (r == BMI088_OK) {
        bmi088_read_id(&acc_id, &gyro_id);
        imu_chip_id_acc  = acc_id;
        imu_chip_id_gyro = gyro_id;
    } else {
        /* ID 错误时也把读到的值暴露出来，方便定位是"读不到"还是"读错" */
        bmi088_read_id(&acc_id, &gyro_id);
        imu_chip_id_acc  = acc_id;
        imu_chip_id_gyro = gyro_id;
    }

    {
        uint8_t t = 0;
        bmi088_dbg_read_acc(0x00, &t); imu_dbg_chip_id  = t;
        bmi088_dbg_read_acc(0x7D, &t); imu_dbg_pwr_ctrl = t;
        bmi088_dbg_read_acc(0x7C, &t); imu_dbg_pwr_conf = t;
        bmi088_dbg_read_acc(0x40, &t); imu_dbg_conf     = t;
        bmi088_dbg_read_acc(0x41, &t); imu_dbg_range    = t;
    }

    s_last_tick = HAL_GetTick();
    s_led_state = 0xFF;
    return r;
}

void motion_monitor_task(void)
{
    int16_t acc[3], gyro[3];
    float ax, ay, az, gx, gy, gz;
    float pitch_acc, roll_acc;
    float dt;
    uint32_t now;

    if (imu_init_status != BMI088_OK) return;   /* 初始化失败就不动，保持两灯熄灭 */

    if (bmi088_read_raw(acc, gyro) != BMI088_OK) return;

    imu_acc_x = acc[0];  imu_acc_y = acc[1];  imu_acc_z = acc[2];
    imu_gyro_x = gyro[0]; imu_gyro_y = gyro[1]; imu_gyro_z = gyro[2];

    /* 原始值转物理量 */
    ax = (float)acc[0] / bmi088_acc_lsb_per_g();
    ay = (float)acc[1] / bmi088_acc_lsb_per_g();
    az = (float)acc[2] / bmi088_acc_lsb_per_g();
    gx = (float)gyro[0] / bmi088_gyro_lsb_per_dps();
    gy = (float)gyro[1] / bmi088_gyro_lsb_per_dps();
    gz = (float)gyro[2] / bmi088_gyro_lsb_per_dps();

    imu_acc_norm  = sqrtf(ax * ax + ay * ay + az * az);
    imu_gyro_norm = sqrtf(gx * gx + gy * gy + gz * gz);

    /* ---- 互补滤波出姿态角（简版，仅供观察） ---- */
    now = HAL_GetTick();
    dt = (float)(now - s_last_tick) * 0.001f;
    s_last_tick = now;
    if (dt <= 0.0f || dt > 0.2f) dt = 0.005f;   /* 异常间隔兜底 */

    pitch_acc = atan2f(-ax, sqrtf(ay * ay + az * az)) * RAD_TO_DEG;
    roll_acc  = atan2f(ay, az) * RAD_TO_DEG;

    imu_pitch = COMP_FILTER_ALPHA * (imu_pitch + gy * dt)
              + (1.0f - COMP_FILTER_ALPHA) * pitch_acc;
    imu_roll  = COMP_FILTER_ALPHA * (imu_roll + gx * dt)
              + (1.0f - COMP_FILTER_ALPHA) * roll_acc;

    /* ---- 运动判定 + 去抖 ---- */
    uint8_t moving_now = 0;
    if (fabsf(imu_acc_norm - 1.0f) > MOTION_ACC_THRESH_G) moving_now = 1;
    if (imu_gyro_norm > MOTION_GYRO_THRESH_DPS)            moving_now = 1;

    if (moving_now) {
        if (s_debounce < MOTION_DEBOUNCE_N) s_debounce++;
    } else {
        if (s_debounce > 0U) s_debounce--;
    }

    uint8_t state = (s_debounce > (MOTION_DEBOUNCE_N / 2U)) ? 1U : 0U;
    imu_moving = state;

    /* ---- 只在状态变化时操作 LED ---- */
    if (state != s_led_state) {
        s_led_state = state;
        if (state) {          /* 运动：红灯亮，绿灯灭 */
            led_green(0);
            led_red(1);
        } else {              /* 静止：绿灯亮，红灯灭 */
            led_red(0);
            led_green(1);
        }
    }
}

uint8_t motion_monitor_is_moving(void)
{
    return imu_moving;
}
