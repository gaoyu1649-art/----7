/* USER CODE BEGIN 0 */
volatile uint32_t timer = 0;
char rec[50];
char HX[]="PWM";
int angle=500;
volatile uint32_t pwm_on=0;
uint32_t LEDTIME[3]={0,0,0};
static int32_t tim1=0,tim2=0,tim3=0;
static char bufR[16];
static char bufG[16];
static char bufB[16];



static int itc(uint32_t v, char *out)
{
  char tmp[10];
  int n = 0, k = 0;

  if (v == 0) { out[0] = '0'; return 1; }

  while (v > 0) { tmp[n++] = (char)('0' + v % 10); v /= 10; }
  while (n > 0) out[k++] = tmp[--n];
  return k;
}




void HAL_UARTEx_RxEventCallback(UART_HandleTypeDef *huart, uint16_t Size)
{


  if (huart->Instance == USART1) {

    HAL_UARTEx_ReceiveToIdle_DMA(&huart1, (uint8_t *)rec, sizeof(rec));
    __HAL_DMA_DISABLE_IT(huart1.hdmarx, DMA_IT_HT);

    if (rec[0]=='R'||rec[0]=='G'||rec[0]=='B') {
      if (Size<2) return;
      if (rec[1]=='1') {
        switch (rec[0]) {
          case 'R': HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_SET); LEDTIME[0]=HAL_GetTick();break;
          case 'G': pwm_on=0; __HAL_TIM_SET_COMPARE(&htim5, TIM_CHANNEL_2, 1000); LEDTIME[1]=HAL_GetTick();break;
          case 'B': HAL_GPIO_WritePin(LED_B_GPIO_Port, LED_B_Pin, GPIO_PIN_SET); LEDTIME[2]=HAL_GetTick();break;
        }
      }
      else if (rec[1]=='0') {
        switch (rec[0]) {
          case 'R':
            HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_RESET);
            int i = 0;
            tim1=(HAL_GetTick()-LEDTIME[0])/1000;
            i += itc(tim1, &bufR[i]);

            HAL_UART_Transmit_DMA(&huart1, (uint8_t *)bufR, (uint16_t)i);
            break;
          case 'G':
            pwm_on=0; __HAL_TIM_SET_COMPARE(&htim5, TIM_CHANNEL_2, 0);
            int j= 0;
            tim2=(HAL_GetTick()-LEDTIME[1])/1000;
            j += itc(tim2, &bufG[j]);

            HAL_UART_Transmit_DMA(&huart1, (uint8_t *)bufG, (uint16_t)j);
            break;
          case 'B':
            HAL_GPIO_WritePin(LED_B_GPIO_Port, LED_B_Pin, GPIO_PIN_RESET);
            int k = 0;
            tim3=(HAL_GetTick()-LEDTIME[2])/1000;
            k += itc(tim3, &bufB[k]);

            HAL_UART_Transmit_DMA(&huart1, (uint8_t *)bufB, (uint16_t)k);
            break;
        }
      }
    }


    if(Size==3) {
      if (!strncmp(rec,"PWM",3)) {
        pwm_on=1;
      }
    }

    if (Size>5) {
      char check[6]={0};
      int deg[3]={-1,-1,-1};
      int deg0;
      for (int i=0;i<5;i++) {
        check[i]=rec[i];
      }
      if (strcmp(check,"servo")==0) {
        for (int i=5;i<(int)Size-1&&i-5<3;i++) {
          deg[i-5]=rec[i]-'0';
        }

        if (deg[1]==-1) deg0=deg[0];
        else if (deg[2]==-1) deg0=deg[0]*10+deg[1];
        else  deg0=deg[0]*100+deg[1]*10+deg[2];

        if (deg0>180) {
          pwm_on=0; __HAL_TIM_SET_COMPARE(&htim5, TIM_CHANNEL_2, 0);
          HAL_GPIO_WritePin(LED_B_GPIO_Port, LED_B_Pin, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_SET);
          return;
        }


        if (rec[Size-1]=='L') {
          angle-=(deg0*2000/180);
          if (angle<500) angle=500;
        }
        else if (rec[Size-1]=='R') {
          angle+=(deg0*2000/180);
          if (angle>2500) angle=2500;
        }
        else {
          pwm_on=0; __HAL_TIM_SET_COMPARE(&htim5, TIM_CHANNEL_2, 0);
          HAL_GPIO_WritePin(LED_B_GPIO_Port, LED_B_Pin, GPIO_PIN_RESET);
          HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_SET);
          return;
        }

        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, angle);

      }
      else {
        pwm_on=0; __HAL_TIM_SET_COMPARE(&htim5, TIM_CHANNEL_2, 0);
        HAL_GPIO_WritePin(LED_B_GPIO_Port, LED_B_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_SET);
        return;
      }

    }

  }
}
