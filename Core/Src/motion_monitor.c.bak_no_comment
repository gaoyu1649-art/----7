#include "main.h"
#include "bsp_bmi088.h"
#include "motion_monitor.h"
#include <math.h>


#define ACC_DEVIATION   0.10f
#define GYRO_THRESHOLD  8.0f

volatile int16_t imu_acc_x = 0, imu_acc_y = 0, imu_acc_z = 0;
volatile int16_t imu_gyro_x = 0, imu_gyro_y = 0, imu_gyro_z = 0;
volatile uint8_t imu_moving = 0;
volatile int8_t  imu_init_status = -1;

int motion_monitor_init(void)
{
    imu_init_status = (int8_t)bmi088_init(BMI088_ACC_6G, BMI088_GYRO_1000DPS);

    HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(LED_G_GPIO_Port, LED_G_Pin, GPIO_PIN_RESET);

    return imu_init_status;
}

void motion_monitor_task(void)
{
    int16_t acc[3];
    int16_t gyro[3];
    float ax, ay, az, gx, gy, gz;
    float acc_norm, gyro_norm;

    if (imu_init_status != BMI088_OK) return;
    if (bmi088_read_raw(acc, gyro) != BMI088_OK) return;

    imu_acc_x = acc[0];   imu_acc_y = acc[1];   imu_acc_z = acc[2];
    imu_gyro_x = gyro[0]; imu_gyro_y = gyro[1]; imu_gyro_z = gyro[2];

    ax = (float)acc[0] / bmi088_acc_lsb_per_g();
    ay = (float)acc[1] / bmi088_acc_lsb_per_g();
    az = (float)acc[2] / bmi088_acc_lsb_per_g();
    gx = (float)gyro[0] / bmi088_gyro_lsb_per_dps();
    gy = (float)gyro[1] / bmi088_gyro_lsb_per_dps();
    gz = (float)gyro[2] / bmi088_gyro_lsb_per_dps();

    acc_norm  = sqrtf(ax * ax + ay * ay + az * az);
    gyro_norm = sqrtf(gx * gx + gy * gy + gz * gz);

    if (fabsf(acc_norm - 1.0f) > ACC_DEVIATION || gyro_norm > GYRO_THRESHOLD)
    {
        imu_moving = 1;
        HAL_GPIO_WritePin(LED_G_GPIO_Port, LED_G_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_SET);
    }
    else
    {
        imu_moving = 0;
        HAL_GPIO_WritePin(LED_R_GPIO_Port, LED_R_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(LED_G_GPIO_Port, LED_G_Pin, GPIO_PIN_SET);
    }
}
